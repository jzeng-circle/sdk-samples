# Your internal/aggregation wallet private key (holds funds after sweep)
INTERNAL_WALLET_KEY=0xYourInternalWalletPrivateKey

# Circle App Kit key (required for swap operations)
KIT_KEY=your_kit_key

# Your platform fee collection wallet address
PLATFORM_FEE_ADDRESS=0xYourFeeWalletAddress

# Optional: Alchemy RPC key for reliable production RPC
ALCHEMY_KEY=your_alchemy_key

# Server port (default 3000)
PORT=3000
