# Circle API credentials — from console.circle.com
CIRCLE_API_KEY=TEST_API_KEY:your_key_here
CIRCLE_ENTITY_SECRET=your_64_char_hex_entity_secret_here

# Your internal/aggregation Circle wallet (from console.circle.com → Wallets)
INTERNAL_WALLET_ADDRESS=0xYourInternalWalletAddress

# Circle wallet set ID — temp wallets are created inside this set
WALLET_SET_ID=your_wallet_set_uuid

# App Kit key — required for kit.swap()
KIT_KEY=your_kit_key

# Circle Modular Wallets — required for test-modular-send.ts
# Get from console.circle.com → Modular Wallets → App Settings
MODULAR_WALLETS_URL=https://modular-wallets.circle.com/v1
MODULAR_WALLETS_APP_ID=your_modular_wallets_app_id
# Private key of the EOA that owns the modular smart account (0x-prefixed hex)
MODULAR_WALLET_PRIVATE_KEY=0xyour_private_key_here

# Platform fee collection address (any EVM wallet you control)
PLATFORM_FEE_ADDRESS=0xYourFeeWalletAddress
