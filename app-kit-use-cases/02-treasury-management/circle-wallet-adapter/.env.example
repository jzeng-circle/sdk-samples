# Circle Developer Console credentials (https://console.circle.com/)
CIRCLE_API_KEY=your_circle_api_key
CIRCLE_ENTITY_SECRET=your_entity_secret

# The Circle wallet that holds the treasury — same wallet/address used on every chain
TREASURY_WALLET_ID=your_treasury_wallet_id
TREASURY_ADDRESS=0xYourTreasuryAddress

# Circle App Kit key — required for kit.swap()
KIT_KEY=your_kit_key
