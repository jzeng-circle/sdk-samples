# Treasury wallet private key — signs swaps, deposits, and spends on every chain
TREASURY_WALLET_KEY=0xYourTreasuryWalletPrivateKey

# Treasury wallet's EOA address (must match TREASURY_WALLET_KEY)
TREASURY_ADDRESS=0xYourTreasuryAddress

# Circle App Kit key — required for kit.swap()
KIT_KEY=your_kit_key
